<?xml version="1.0" encoding="utf-8"?>
<manifest manifest-version="0.1" xmlns="http://www.tableau.com/xml/extension_manifest">
  <dashboard-extension id="com.roulette.spread.unified" extension-version="2.0.0">
    <default-locale>en_US</default-locale>
    <name resource-id="name"/>
    <description>Unified roulette spread extension: European and American wheels, Native and EUR currency, with optional winning number.</description>
    <author name="Roulette Spread" email="267653173+fraud-commits@users.noreply.github.com" organization="Independent" website="https://github.com/fraud-commits/roulette-spread-unified"/>
    <min-api-version>1.7</min-api-version>
    <source-location>
      <url>https://fraud-commits.github.io/roulette-spread-unified/index.html</url>
    </source-location>
  </dashboard-extension>
  <resources>
    <resource id="name">
      <text locale="en_US">Roulette Spread — Unified</text>
    </resource>
  </resources>
</manifest>
